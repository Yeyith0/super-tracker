{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimum permissions for the main Super Tracker window: custom HUD title bar, external links, auto-update and the content channel.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "mailto:*" }]
    },
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://raw.githubusercontent.com/Yeyith0/super-tracker/main/*" }]
    }
  ]
}
